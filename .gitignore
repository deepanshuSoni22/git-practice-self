# write gitignore rules here for java projects

# Build output
target/
build/
out/
bin/

# Compiled class files
*.class

# Package files
*.jar
*.war
*.ear

# Logs
*.log

# Maven
.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# Gradle
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# IDE files
.idea/
*.iml
.project
.classpath
.settings/
.vscode/

# OS files
.DS_Store
Thumbs.db